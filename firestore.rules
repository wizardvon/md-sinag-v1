    function validObservationValues() {
      return validObservationFields()
        && request.resource.data.teacherUid is string
        && request.resource.data.teacherUid.size() > 0
        && request.resource.data.teacherName is string
        && request.resource.data.teacherName.size() > 0
        && request.resource.data.observerUid is string
        && request.resource.data.observerName is string
        && request.resource.data.observerName.size() > 0
        && request.resource.data.observerRole in ["Principal", "Master Teacher", "Head Teacher"]
