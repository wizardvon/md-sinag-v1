        && request.resource.data.subject.size() > 0
        && request.resource.data.gradeLevel is string
        && request.resource.data.gradeLevel.size() > 0
        && request.resource.data.section is string
        && request.resource.data.section.size() > 0
        && request.resource.data.observationDate is string
        && request.resource.data.observationDate.size() > 0
        && request.resource.data.observationTime is string
        && request.resource.data.observationTime.size() > 0
        && validObservationType(request.resource.data.observationType)
        && validObservationStatus(request.resource.data.status)
        && request.resource.data.preObservationNotes is string
        && request.resource.data.postObservationNotes is string
        && request.resource.data.observationReportLink is string
        && request.resource.data.remarks is string
        && request.resource.data.createdByUid is string
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() > 0;
