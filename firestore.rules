    function validNotificationType(notificationType) {
      return notificationType in [
        "report_assigned",
        "report_submitted",
        "report_returned",
        "report_approved",
        "observation_scheduled",
        "observation_completed",
        "learner_risk_added",
        "learner_intervention_updated",
        "enrollment_updated",
        "transfer_record_added",
        "dropout_record_added",
        "document_uploaded",
        "dll_request_created",
        "dll_request_status_changed",
        "lesson_plan_submitted",
        "lesson_plan_resubmitted",
        "lesson_plan_returned",
        "lesson_plan_noted",
        "lesson_plan_confirmed",
        "pending_user_approval",
        "user_approved",
        "reminder_due_today",
        "late_submission"
      ];
    }

    function validNotificationFields() {
      return request.resource.data.keys().hasOnly([
        "recipientUid",
        "recipientName",
        "recipientRole",
        "senderUid",
        "senderName",
        "senderRole",
        "notificationType",
        "title",
        "message",
        "relatedModule",
        "relatedRecordId",
        "actionUrl",
        "isRead",
        "createdAt"
      ]);
