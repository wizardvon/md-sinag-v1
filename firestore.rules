    function validLessonPlanSubmissionValues() {
      return isTeacherWorkloadViewer()
        && hasAnyCurrentRole(["Teacher", "Master Teacher", "Head Teacher"])
        && validLessonPlanFields()
        && request.resource.data.requestId is string
        && request.resource.data.requestId.size() > 0
        && exists(/databases/$(database)/documents/dllRequests/$(request.resource.data.requestId))
        && get(/databases/$(database)/documents/dllRequests/$(request.resource.data.requestId)).data.status == "Active"
        && request.resource.data.requestTitle == get(/databases/$(database)/documents/dllRequests/$(request.resource.data.requestId)).data.title
        && request.resource.data.schoolYear == get(/databases/$(database)/documents/dllRequests/$(request.resource.data.requestId)).data.schoolYear
        && request.resource.data.term == get(/databases/$(database)/documents/dllRequests/$(request.resource.data.requestId)).data.term
        && request.resource.data.weekLabel == get(/databases/$(database)/documents/dllRequests/$(request.resource.data.requestId)).data.weekLabel
        && request.resource.data.weekStart == get(/databases/$(database)/documents/dllRequests/$(request.resource.data.requestId)).data.weekStart
        && request.resource.data.weekEnd == get(/databases/$(database)/documents/dllRequests/$(request.resource.data.requestId)).data.weekEnd
        && request.resource.data.dueDate == get(/databases/$(database)/documents/dllRequests/$(request.resource.data.requestId)).data.dueDate
        && request.resource.data.workloadId is string
        && request.resource.data.workloadId.size() > 0
        && exists(/databases/$(database)/documents/teacherWorkloads/$(request.resource.data.workloadId))
        && get(/databases/$(database)/documents/teacherWorkloads/$(request.resource.data.workloadId)).data.teacherId == request.auth.uid
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherName is string
        && request.resource.data.teacherName.size() > 0
        && request.resource.data.teacherRole in currentRoles()
        && request.resource.data.teacherRole in ["Teacher", "Master Teacher", "Head Teacher"]
        && request.resource.data.subjectId == get(/databases/$(database)/documents/teacherWorkloads/$(request.resource.data.workloadId)).data.subjectId
        && request.resource.data.subjectName == get(/databases/$(database)/documents/teacherWorkloads/$(request.resource.data.workloadId)).data.subjectName
        && request.resource.data.subjectArea == get(/databases/$(database)/documents/teacherWorkloads/$(request.resource.data.workloadId)).data.subjectArea
        && request.resource.data.sectionId == get(/databases/$(database)/documents/teacherWorkloads/$(request.resource.data.workloadId)).data.sectionId
        && request.resource.data.sectionName == get(/databases/$(database)/documents/teacherWorkloads/$(request.resource.data.workloadId)).data.sectionName
        && request.resource.data.gradeLevel == get(/databases/$(database)/documents/teacherWorkloads/$(request.resource.data.workloadId)).data.gradeLevel
        && (
          (
            "schoolYear" in get(/databases/$(database)/documents/teacherWorkloads/$(request.resource.data.workloadId)).data
            && request.resource.data.schoolYear == get(/databases/$(database)/documents/teacherWorkloads/$(request.resource.data.workloadId)).data.schoolYear
          )
          || (
            exists(/databases/$(database)/documents/classes/$(request.resource.data.sectionId))
            && request.resource.data.schoolYear == get(/databases/$(database)/documents/classes/$(request.resource.data.sectionId)).data.schoolYear
          )
        )
        && request.resource.data.submissionType in ["Hard Copy", "Soft Copy"]
        && request.resource.data.fileLink is string
        && request.resource.data.submittedTo is string
        && (
          (
            request.resource.data.submissionType == "Soft Copy"
            && request.resource.data.fileLink.matches('^https?://.+')
            && request.resource.data.submittedTo == ""
          )
          || (
            request.resource.data.submissionType == "Hard Copy"
            && request.resource.data.fileLink == ""
            && request.resource.data.submittedTo.size() > 0
          )
        )
        && request.resource.data.teacherRemarks is string
        && request.resource.data.status == "Submitted"
        && request.resource.data.submittedAt is timestamp
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() > 0
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

