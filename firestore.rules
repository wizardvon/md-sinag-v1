    function validTeacherAttendanceWrite() {
      return request.resource.data.teacherId is string
        && request.resource.data.teacherName is string
        && request.resource.data.attendanceDate is string
        && validTeacherAttendanceStatus(request.resource.data.status)
        && request.resource.data.encodedBy == request.auth.uid;
