        && validPpaCategory(request.resource.data.ppaCategory)
        && validPpaQuarter(request.resource.data.monitoringQuarter)
        && request.resource.data.monitoringDate is string
        && request.resource.data.monitoringDate.size() > 0
        && request.resource.data.schoolYear is string
        && request.resource.data.schoolYear.size() > 0
        && request.resource.data.programProponent is string
        && request.resource.data.programProponent.size() > 0
        && request.resource.data.targetBeneficiaries is string
        && request.resource.data.targetBeneficiaries.size() > 0
        && validPpaStatus(request.resource.data.implementationStatus)
        && request.resource.data.accomplishmentSummary is string
        && request.resource.data.findingsResults is string
        && request.resource.data.recommendation is string
        && request.resource.data.remarksTAProvided is string
        && request.resource.data.nextSteps is string
        && request.resource.data.movLinks is list
        && request.resource.data.movLinks.size() == 1
        && validGoogleDriveFolderLink(request.resource.data.movLinks[0])
        && request.resource.data.conformeSchoolHead is string
        && request.resource.data.checklistIndicators is list
        && request.resource.data.checklistIndicators.size() == 18
        && request.resource.data.createdByUid is string
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() > 0
        && validRole(request.resource.data.createdByRole);
