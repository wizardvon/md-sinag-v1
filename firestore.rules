rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function isApprovedPrincipal() {
      return signedIn()
        && userDoc(request.auth.uid).data.status == "approved"
        && hasCurrentRole("Principal");
    }

    function currentRole() {
      return userDoc(request.auth.uid).data.role;
    }

    function currentRoles() {
      return rolesForUser(request.auth.uid);
    }

    function rolesForUser(uid) {
      let user = userDoc(uid).data;
      return user.keys().hasAny(["roles"]) && user.roles is list
        ? user.roles
        : [user.role];
    }

    function hasCurrentRole(role) {
      return role in currentRoles();
    }

    function hasAnyCurrentRole(roleList) {
      return currentRoles().hasAny(roleList);
    }

    function isApprovedRole(role) {
      return signedIn()
        && userDoc(request.auth.uid).data.status == "approved"
        && hasCurrentRole(role);
    }

    function isAssignmentCreator() {
      return signedIn()
        && userDoc(request.auth.uid).data.status == "approved"
        && hasAnyCurrentRole(["Principal", "Master Teacher", "Head Teacher"]);
    }

    function isComplianceRole() {
      return signedIn()
        && userDoc(request.auth.uid).data.status == "approved"
        && hasAnyCurrentRole([
          "Teacher",
          "Master Teacher",
          "Head Teacher",
          "Registrar",
          "Administrative Officer",
          "Administrative Assistant"
        ]);
    }

    function isLearnerMonitorRole() {
      return signedIn()
        && userDoc(request.auth.uid).data.status == "approved"
        && hasAnyCurrentRole([
          "Principal",
          "Master Teacher",
          "Head Teacher",
          "Teacher",
          "Registrar",
          "Administrative Officer",
          "Administrative Assistant"
        ]);
    }

    function validRole(role) {
      return role in [
        "Principal",
        "Master Teacher",
        "Head Teacher",
        "Teacher",
        "Registrar",
        "Administrative Officer",
        "Administrative Assistant"
      ];
    }

    function validRoleList(roleList) {
      return roleList is list
        && roleList.size() > 0
        && roleList.size() <= 7
        && roleList.hasOnly([
          "Principal",
          "Master Teacher",
          "Head Teacher",
          "Teacher",
          "Registrar",
          "Administrative Officer",
          "Administrative Assistant"
        ]);
    }

    function validNewUserProfile(userId) {
      return request.resource.data.keys().hasOnly([
          "uid",
          "fullName",
          "email",
          "requestedRole",
          "role",
          "status",
          "createdAt"
        ])
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && validRole(request.resource.data.requestedRole)
        && request.resource.data.role == null
        && request.resource.data.status == "pending";
    }

    function validPrincipalApproval() {
      return isApprovedPrincipal()
        && (
          resource.data.status == "pending"
          || !resource.data.keys().hasAny(["status"])
          || resource.data.status == ""
        )
        && request.resource.data.status == "approved"
        && validRole(request.resource.data.role)
        && validRoleList(request.resource.data.roles)
        && request.resource.data.role in request.resource.data.roles
        && request.resource.data.approvedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "role",
          "roles",
          "status",
          "approvedAt",
          "approvedBy"
        ]);
    }

    function validPrincipalRoleChange(userId) {
      return isApprovedPrincipal()
        && request.auth.uid != userId
        && resource.data.status == "approved"
        && request.resource.data.status == "approved"
        && validRole(request.resource.data.role)
        && validRoleList(request.resource.data.roles)
        && request.resource.data.role in request.resource.data.roles
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "role",
          "roles"
        ]);
    }

    function canReadUserProfile(userId) {
      return signedIn()
        && (
          request.auth.uid == userId
          || isApprovedPrincipal()
          || (isAssignmentCreator() && resource.data.status == "approved")
          || (
            userDoc(request.auth.uid).data.status == "approved"
            && hasAnyCurrentRole(["Registrar", "Administrative Officer", "Administrative Assistant"])
            && resource.data.status == "approved"
          )
        );
    }

    function validReportAssignmentType(reportType) {
      return reportType in [
        "Exam / Test Questions",
        "Table of Specifications (TOS)",
        "Accomplishment Report",
        "Intervention Report",
        "DRRM Report",
        "IPCRF Submission",
        "201 Files Submission",
        "LAC Report",
        "Research Report",
        "Brigada Eskwela Report",
        "SIP / AIP Report",
        "Compliance Report",
        "Memorandum Compliance",
        "Training / Seminar Report",
        "School Forms Submission",
        "Ancillary Assignment Report",
        "Other"
      ];
    }

    function validLearnerConcernType(concernType) {
      return concernType in [
        "Academic Performance",
        "Attendance",
        "Reading",
        "Numeracy",
        "Behavior",
        "Violence Incident",
        "Incomplete Requirements",
        "Health/Welfare",
        "Parent Communication",
        "Home Visitation",
        "Dropout Risk",
        "Transfer Concern",
        "Other"
      ];
    }

    function validLearnerRiskLevel(riskLevel) {
      return riskLevel in ["Stable", "Needs Monitoring", "High Risk"];
    }

    function validLearnerInterventionStatus(status) {
      return status in [
        "Not Started",
        "Ongoing",
        "Improved",
        "Referred",
        "Resolved",
        "Unresolved"
      ];
    }

    function validLearnerStatus(status) {
      return status in [
        "Active Monitoring",
        "For Intervention",
        "Under Intervention",
        "Resolved",
        "Referred",
        "Closed"
      ];
    }

    function validObservationType(observationType) {
      return observationType in [
        "Formal Observation",
        "Informal Observation",
        "Coaching/Mentoring",
        "Follow-up Observation",
        "Other"
      ];
    }

    function validObservationStatus(status) {
      return status in [
        "Scheduled",
        "Confirmed",
        "Completed",
        "Rescheduled",
        "Cancelled"
      ];
    }

    function isEnrollmentMonitorRole() {
      return signedIn()
        && userDoc(request.auth.uid).data.status == "approved"
        && hasAnyCurrentRole([
          "Principal",
          "Master Teacher",
          "Head Teacher",
          "Teacher",
          "Registrar"
        ]);
    }

    function validEnrollmentStatus(status) {
      return status in ["Enrolled", "Pending", "Dropped", "Transferred", "Completed"];
    }

    function validTransferType(transferType) {
      return transferType in ["Transfer In", "Transfer Out"];
    }

    function validDropoutRiskLevel(riskLevel) {
      return riskLevel in ["Low", "Moderate", "High"];
    }

    function validDropoutStatus(status) {
      return status in [
        "At Risk",
        "Under Monitoring",
        "Returned",
        "Confirmed Dropout",
        "Resolved"
      ];
    }

    function validDocumentCategory(category) {
      return category in [
        "Memoranda",
        "Templates",
        "Reports",
        "Certificates",
        "MOVs",
        "School Forms",
        "Classroom Observation Reports",
        "Instructional Materials",
        "Governance Documents",
        "Financial Documents",
        "Enrollment Documents",
        "Other"
      ];
    }

    function isDocumentRole() {
      return signedIn()
        && userDoc(request.auth.uid).data.status == "approved"
        && hasAnyCurrentRole([
          "Principal",
          "Master Teacher",
          "Head Teacher",
          "Teacher",
          "Registrar",
          "Administrative Officer",
          "Administrative Assistant"
        ]);
    }

    function isInventoryFacilityViewer() {
      return signedIn()
        && userDoc(request.auth.uid).data.status == "approved"
        && hasAnyCurrentRole(["Principal", "Head Teacher", "Administrative Assistant"]);
    }

    function isInventoryFacilityManager() {
      return signedIn()
        && userDoc(request.auth.uid).data.status == "approved"
        && hasAnyCurrentRole(["Principal", "Administrative Assistant"]);
    }

    function validInventoryCategory(category) {
      return category in [
        "Classroom Furniture",
        "ICT Equipment",
        "Learning Materials",
        "Laboratory Equipment",
        "Sports Equipment",
        "Clinic Supplies",
        "Library Resources",
        "Office Equipment",
        "Facilities",
        "Other"
      ];
    }

    function validInventoryCondition(condition) {
      return condition in ["New", "Good", "Fair", "Needs Repair", "Unserviceable", "Missing"];
    }

    function validInventoryStatus(status) {
      return status in ["Available", "In Use", "For Repair", "Condemned", "Lost", "Disposed"];
    }

    function isFinancialReportViewer() {
      return signedIn()
        && userDoc(request.auth.uid).data.status == "approved"
        && hasAnyCurrentRole([
          "Principal",
          "Master Teacher",
          "Head Teacher",
          "Teacher",
          "Registrar",
          "Administrative Officer",
          "Administrative Assistant"
        ]);
    }

    function isFinancialReportManager() {
      return signedIn()
        && userDoc(request.auth.uid).data.status == "approved"
        && hasAnyCurrentRole(["Principal", "Administrative Officer", "Administrative Assistant"]);
    }

    function isFinancialReportReviewer() {
      return signedIn()
        && userDoc(request.auth.uid).data.status == "approved"
        && hasAnyCurrentRole(["Principal", "Master Teacher", "Head Teacher"]);
    }

    function validFinancialReportType(reportType) {
      return reportType in [
        "MOOE Utilization",
        "Project Expense",
        "Procurement",
        "Donation",
        "Maintenance",
        "Other"
      ];
    }

    function validFinancialQuarter(quarter) {
      return quarter in ["Q1", "Q2", "Q3", "Q4"];
    }

    function validFinancialFundSource(fundSource) {
      return fundSource in ["MOOE", "Donation", "LGU", "PTA", "Other"];
    }

    function validFinancialCategory(category) {
      return category in ["Supplies", "Equipment", "Repairs", "Utilities", "Training", "Program Expense", "Other"];
    }

    function validFinancialStatus(status) {
      return status in ["Draft", "Submitted", "Reviewed", "Approved"];
    }

    function validFinancialFields() {
      return request.resource.data.keys().hasOnly([
        "reportTitle",
        "reportType",
        "quarter",
        "schoolYear",
        "date",
        "fundSource",
        "category",
        "description",
        "amountAllocated",
        "amountSpent",
        "remainingBalance",
        "status",
        "remarks",
        "encodedBy",
        "encodedAt",
        "updatedAt",
        "createdBy",
        "createdByName",
        "createdAt",
        "importedBatchId",
        "source"
      ]);
    }

    function validFinancialValues() {
      return validFinancialFields()
        && request.resource.data.reportTitle is string
        && request.resource.data.reportTitle.size() > 0
        && validFinancialReportType(request.resource.data.reportType)
        && validFinancialQuarter(request.resource.data.quarter)
        && request.resource.data.schoolYear is string
        && request.resource.data.schoolYear.size() > 0
        && request.resource.data.date is string
        && request.resource.data.date.size() > 0
        && validFinancialFundSource(request.resource.data.fundSource)
        && validFinancialCategory(request.resource.data.category)
        && request.resource.data.description is string
        && request.resource.data.amountAllocated is number
        && request.resource.data.amountSpent is number
        && request.resource.data.remainingBalance is number
        && request.resource.data.remainingBalance == request.resource.data.amountAllocated - request.resource.data.amountSpent
        && validFinancialStatus(request.resource.data.status)
        && request.resource.data.remarks is string
        && request.resource.data.encodedBy is string
        && request.resource.data.encodedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() > 0
        && request.resource.data.createdAt is timestamp
        && request.resource.data.importedBatchId is string
        && request.resource.data.source in ["manual", "excel_import"];
    }

    function validFinancialCreate() {
      return isFinancialReportManager()
        && validFinancialValues()
        && request.resource.data.encodedBy == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid;
    }

    function validFinancialManagerUpdate() {
      return isFinancialReportManager()
        && validFinancialValues()
        && request.resource.data.encodedBy == resource.data.encodedBy
        && request.resource.data.encodedAt == resource.data.encodedAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdByName == resource.data.createdByName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.importedBatchId == resource.data.importedBatchId
        && request.resource.data.source == resource.data.source;
    }

    function validFinancialReviewUpdate() {
      return isFinancialReportReviewer()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
        && request.resource.data.status in ["Submitted", "Reviewed"];
    }

    function isPpaRole() {
      return signedIn()
        && userDoc(request.auth.uid).data.status == "approved"
        && hasAnyCurrentRole([
          "Principal",
          "Master Teacher",
          "Head Teacher",
          "Teacher",
          "Registrar",
          "Administrative Officer",
          "Administrative Assistant"
        ]);
    }

    function validPpaCategory(category) {
      return category in ["Access", "Quality", "Governance"];
    }

    function validPpaStatus(status) {
      return status in [
        "Not Started",
        "Ongoing",
        "Completed",
        "For Improvement",
        "Needs Technical Assistance"
      ];
    }

    function validPpaQuarter(quarter) {
      return quarter in ["1st Term", "2nd Term", "3rd Term", "Q1", "Q2", "Q3"];
    }

    function validGoogleDriveFolderLink(link) {
      return link is string
        && link.matches("^https?://drive\\.google\\.com/.*/folders/[^/]+.*$");
    }

    function validLrn(lrn) {
      return lrn is string && lrn.matches("^[0-9]{12}$");
    }

    function validSubmissionType(submissionType) {
      return submissionType in ["Hard Copy", "Soft Copy"];
    }

    function validReviewerStatus(status) {
      return status in [
        "Received",
        "Checked",
        "Returned for Revision",
        "Approved",
        "Late",
        "Not Submitted"
      ];
    }

    function validAssignableRole(role) {
      return (hasCurrentRole("Principal") && validRole(role))
        || (hasAnyCurrentRole(["Master Teacher", "Head Teacher"]) && role in [
          "Teacher",
          "Registrar",
          "Administrative Officer",
          "Administrative Assistant"
        ]);
    }

    function validReportAssignmentFields() {
      return request.resource.data.keys().hasOnly([
        "title",
        "assignmentGroupId",
        "reportType",
        "description",
        "assignedToType",
        "assignedUserIds",
        "assignedUserNames",
        "totalAssignedCount",
        "assignedByUid",
        "assignedByName",
        "assignedByRole",
        "assignedToUid",
        "assignedToName",
        "assignedToRole",
        "dueDate",
        "allowedSubmissionTypes",
        "submissionType",
        "fileLink",
        "submissionRemarks",
        "reviewRemarks",
        "status",
        "createdAt",
        "submittedAt",
        "reviewedAt",
        "reviewedByUid",
        "reviewedByName",
        "updatedAt"
      ]);
    }

    function validReportAssignmentCreate() {
      return isAssignmentCreator()
        && validReportAssignmentFields()
        && request.resource.data.assignedByUid == request.auth.uid
        && request.resource.data.assignedByRole in currentRoles()
        && request.resource.data.assignedByName is string
        && request.resource.data.assignedByName.size() > 0
        && request.resource.data.assignedToUid is string
        && request.resource.data.assignedToUid.size() > 0
        && request.resource.data.assignedToName is string
        && request.resource.data.assignedToName.size() > 0
        && validAssignableRole(request.resource.data.assignedToRole)
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && validReportAssignmentType(request.resource.data.reportType)
        && request.resource.data.description is string
        && request.resource.data.dueDate is string
        && request.resource.data.allowedSubmissionTypes is list
        && request.resource.data.allowedSubmissionTypes.size() > 0
        && request.resource.data.allowedSubmissionTypes.hasOnly(["Hard Copy", "Soft Copy"])
        && request.resource.data.status == "Assigned";
    }

    function validComplianceSubmit() {
      return isComplianceRole()
        && resource.data.assignedToUid == request.auth.uid
        && resource.data.status in ["Assigned", "Returned for Revision", "Late", "Not Submitted"]
        && validReportAssignmentFields()
        && request.resource.data.assignedByUid == resource.data.assignedByUid
        && request.resource.data.assignedByName == resource.data.assignedByName
        && request.resource.data.assignedByRole == resource.data.assignedByRole
        && request.resource.data.assignedToUid == resource.data.assignedToUid
        && request.resource.data.assignedToName == resource.data.assignedToName
        && request.resource.data.assignedToRole == resource.data.assignedToRole
        && request.resource.data.title == resource.data.title
        && request.resource.data.reportType == resource.data.reportType
        && request.resource.data.description == resource.data.description
        && request.resource.data.dueDate == resource.data.dueDate
        && request.resource.data.allowedSubmissionTypes == resource.data.allowedSubmissionTypes
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status == "Submitted"
        && validSubmissionType(request.resource.data.submissionType)
        && request.resource.data.submissionType in resource.data.allowedSubmissionTypes
        && request.resource.data.submissionRemarks is string
        && (
          request.resource.data.submissionType == "Hard Copy"
          || (
            request.resource.data.fileLink is string
            && request.resource.data.fileLink.size() > 0
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "submissionType",
          "fileLink",
          "submissionRemarks",
          "submittedAt",
          "updatedAt"
        ]);
    }

    function validReportReviewUpdate() {
      return isAssignmentCreator()
        && (resource.data.assignedByUid == request.auth.uid || isApprovedPrincipal())
        && validReviewerStatus(request.resource.data.status)
        && request.resource.data.reviewedByUid == request.auth.uid
        && request.resource.data.reviewedByName is string
        && validReportAssignmentFields()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "reviewRemarks",
          "reviewedAt",
          "reviewedByUid",
          "reviewedByName",
          "updatedAt"
        ]);
    }

    function registrarLearnerConcern(concernType) {
      return concernType in [
        "Dropout Risk",
        "Transfer Concern",
        "Incomplete Requirements",
        "Other"
      ];
    }

    function administrativeOfficerLearnerConcern(concernType) {
      return concernType in [
        "Attendance",
        "Health/Welfare",
        "Violence Incident",
        "Behavior"
      ];
    }

    function canReadLearnerRecord() {
      return isLearnerMonitorRole()
        && (
          hasAnyCurrentRole(["Principal", "Master Teacher", "Head Teacher", "Administrative Assistant"])
          || resource.data.createdByUid == request.auth.uid
          || (hasCurrentRole("Registrar") && registrarLearnerConcern(resource.data.concernType))
          || (hasCurrentRole("Administrative Officer") && administrativeOfficerLearnerConcern(resource.data.concernType))
        );
    }

    function validLearnerMonitoringFields() {
      return request.resource.data.keys().hasOnly([
        "learnerName",
        "lrn",
        "gradeLevel",
        "section",
        "adviserUid",
        "adviserName",
        "concernType",
        "concernDescription",
        "riskLevel",
        "attendanceStatus",
        "readingLevel",
        "numeracyLevel",
        "interventionProvided",
        "interventionDate",
        "interventionStatus",
        "parentContacted",
        "parentCommunicationNotes",
        "homeVisitationConducted",
        "homeVisitationDate",
        "behaviorIncident",
        "violenceIncident",
        "incompleteRequirements",
        "healthWelfareConcern",
        "dropoutRisk",
        "transferConcern",
        "status",
        "remarks",
        "createdByUid",
        "createdByName",
        "createdByRole",
        "createdAt",
        "updatedAt"
      ]);
    }

    function validLearnerMonitoringValues() {
      return validLearnerMonitoringFields()
        && request.resource.data.learnerName is string
        && request.resource.data.learnerName.size() > 0
        && validLrn(request.resource.data.lrn)
        && request.resource.data.gradeLevel is string
        && request.resource.data.gradeLevel.size() > 0
        && request.resource.data.section is string
        && request.resource.data.section.size() > 0
        && request.resource.data.adviserUid is string
        && request.resource.data.adviserName is string
        && request.resource.data.adviserName.size() > 0
        && validLearnerConcernType(request.resource.data.concernType)
        && request.resource.data.concernDescription is string
        && validLearnerRiskLevel(request.resource.data.riskLevel)
        && request.resource.data.attendanceStatus is string
        && request.resource.data.readingLevel is string
        && request.resource.data.numeracyLevel is string
        && request.resource.data.interventionProvided is string
        && request.resource.data.interventionDate is string
        && validLearnerInterventionStatus(request.resource.data.interventionStatus)
        && request.resource.data.parentContacted in ["Yes", "No"]
        && request.resource.data.parentCommunicationNotes is string
        && request.resource.data.homeVisitationConducted in ["Yes", "No"]
        && request.resource.data.homeVisitationDate is string
        && request.resource.data.behaviorIncident is string
        && request.resource.data.violenceIncident is string
        && request.resource.data.incompleteRequirements is string
        && request.resource.data.healthWelfareConcern is string
        && request.resource.data.dropoutRisk in ["Yes", "No"]
        && request.resource.data.transferConcern in ["Yes", "No"]
        && validLearnerStatus(request.resource.data.status)
        && request.resource.data.remarks is string;
    }

    function validLearnerCreate() {
      return hasAnyCurrentRole([
          "Principal",
          "Master Teacher",
          "Head Teacher",
          "Teacher",
          "Administrative Assistant"
        ])
        && validLearnerMonitoringValues()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() > 0
        && request.resource.data.createdByRole in currentRoles();
    }

    function validLearnerOwnerEdit() {
      return isLearnerMonitorRole()
        && validLearnerMonitoringValues()
        && (
          resource.data.createdByUid == request.auth.uid
          || hasCurrentRole("Administrative Assistant")
        )
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdByName == resource.data.createdByName
        && request.resource.data.createdByRole == resource.data.createdByRole
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "learnerName",
          "lrn",
          "gradeLevel",
          "section",
          "adviserUid",
          "adviserName",
          "concernType",
          "concernDescription",
          "riskLevel",
          "attendanceStatus",
          "readingLevel",
          "numeracyLevel",
          "interventionProvided",
          "interventionDate",
          "interventionStatus",
          "parentContacted",
          "parentCommunicationNotes",
          "homeVisitationConducted",
          "homeVisitationDate",
          "behaviorIncident",
          "violenceIncident",
          "incompleteRequirements",
          "healthWelfareConcern",
          "dropoutRisk",
          "transferConcern",
          "status",
          "remarks",
          "updatedAt"
        ]);
    }

    function validLearnerInterventionUpdate() {
      return validLearnerMonitoringValues()
        && hasAnyCurrentRole(["Principal", "Master Teacher", "Head Teacher", "Registrar", "Administrative Assistant"])
        && canReadLearnerRecord()
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdByName == resource.data.createdByName
        && request.resource.data.createdByRole == resource.data.createdByRole
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "interventionProvided",
          "interventionDate",
          "interventionStatus",
          "status",
          "remarks",
          "updatedAt"
        ]);
    }

    function canReadObservationRecord() {
      return signedIn()
        && userDoc(request.auth.uid).data.status == "approved"
        && (
          isApprovedPrincipal()
