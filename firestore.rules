    function validStudentAttendanceWrite() {
      return request.resource.data.sectionId is string
        && request.resource.data.studentId is string
        && request.resource.data.studentName is string
        && request.resource.data.attendanceDate is string
        && request.resource.data.adviserId == request.auth.uid
        && validStudentAttendanceStatus(request.resource.data.status)
        && request.resource.data.encodedBy == request.auth.uid;
