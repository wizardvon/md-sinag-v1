    function validStudentBase() {
      return validLrn(request.resource.data.lrn)
        && request.resource.data.lastName is string
        && request.resource.data.firstName is string
        && request.resource.data.sex is string
        && request.resource.data.gradeLevel is string
        && request.resource.data.sectionId is string
        && request.resource.data.sectionName is string
        && request.resource.data.adviserId is string
        && request.resource.data.schoolYear is string
        && request.resource.data.term is string
        && validStudentStatus(request.resource.data.status)
        && request.resource.data.createdByUid is string
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() > 0
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validStudentCreate() {
      return validStudentBase()
        && request.resource.data.createdByUid == request.auth.uid;
    }

    function validStudentUpdate() {
      return validStudentBase()
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdByName == resource.data.createdByName
        && request.resource.data.createdAt == resource.data.createdAt;
