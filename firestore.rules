      return isPpaRole()
        && validPpaValues()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByRole in currentRoles();
    }

    function canUpdatePpaRecord() {
      return isPpaRole()
        && (
          hasCurrentRole("Principal")
          || resource.data.createdByUid == request.auth.uid
        );
