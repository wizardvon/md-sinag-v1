    function validAssessmentWrite() {
      return request.resource.data.schoolYear is string
        && validAssessmentTerm(request.resource.data.term)
        && request.resource.data.gradeLevel is string
        && request.resource.data.sectionId is string
        && request.resource.data.sectionName is string
        && request.resource.data.subjectId is string
        && request.resource.data.subjectName is string
        && request.resource.data.subjectName.size() > 0
        && request.resource.data.teacherUid is string
        && request.resource.data.teacherUid.size() > 0
        && request.resource.data.teacherName is string
        && request.resource.data.teacherName.size() > 0
        && request.resource.data.assessmentType in ["Diagnostic Test", "Term Exam"]
        && request.resource.data.assessmentTitle is string
        && request.resource.data.dateAdministered is string
        && request.resource.data.totalItems is number
        && request.resource.data.numberOfLearners is number
        && request.resource.data.highestScore is number
        && request.resource.data.lowestScore is number
        && request.resource.data.meanScore is number
        && request.resource.data.mps is number
        && request.resource.data.proficiencyLevel is string
        && request.resource.data.remarks is string
        && request.resource.data.studentId is string
        && request.resource.data.adviserId is string
        && request.resource.data.preTestScore is number
        && request.resource.data.postTestScore is number
        && request.resource.data.preHighestPossibleScore is number
        && request.resource.data.postHighestPossibleScore is number
        && request.resource.data.highestPossibleScore is number
        && request.resource.data.preTestScore >= 0
        && request.resource.data.postTestScore >= 0
        && request.resource.data.preHighestPossibleScore >= 0
        && request.resource.data.postHighestPossibleScore >= 0
        && (
          (request.resource.data.preHighestPossibleScore == 0 && request.resource.data.preTestScore == 0)
          || request.resource.data.preTestScore <= request.resource.data.preHighestPossibleScore
        )
        && (
          (request.resource.data.postHighestPossibleScore == 0 && request.resource.data.postTestScore == 0)
          || request.resource.data.postTestScore <= request.resource.data.postHighestPossibleScore
        )
        && request.resource.data.preTestPercentage is number
        && request.resource.data.postTestPercentage is number
        && request.resource.data.improvement is number
        && request.resource.data.improvementPercentage is number
        && request.resource.data.encodedBy == request.auth.uid
        && request.resource.data.createdBy is string
        && request.resource.data.createdByName is string;
    }

    function canWriteAssessmentRecord() {
      return signedIn()
        && userDoc(request.auth.uid).data.status == "approved"
        && hasAnyCurrentRole(["Teacher", "Master Teacher", "Head Teacher"])
        && request.resource.data.teacherUid == request.auth.uid;
    }

    function canReadAssessmentRecord() {
      return canReadAcademicRecord()
        || ("teacherUid" in resource.data && resource.data.teacherUid == request.auth.uid)
        || ("encodedBy" in resource.data && resource.data.encodedBy == request.auth.uid)
        || ("createdBy" in resource.data && resource.data.createdBy == request.auth.uid);
    }

    function validTaskVisibilitySettings() {
      return request.resource.data.keys().hasOnly([
          "gradeTerms",
          "assessmentScopes",
          "lessonPlanWeeks",
          "updatedByUid",
          "updatedAt"
        ])
        && request.resource.data.gradeTerms is list
        && request.resource.data.gradeTerms.size() > 0
        && request.resource.data.gradeTerms.hasOnly(["Term 1", "Term 2", "Term 3"])
        && request.resource.data.assessmentScopes is list
        && request.resource.data.assessmentScopes.size() > 0
        && (
          !request.resource.data.keys().hasAny(["lessonPlanWeeks"])
          || request.resource.data.lessonPlanWeeks is list
        )
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedAt is timestamp;
    }

    function validAuditLogCreate() {
      return signedIn()
        && userDoc(request.auth.uid).data.status == "approved"
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userName is string
        && request.resource.data.role in currentRoles()
        && request.resource.data.action is string
        && request.resource.data.targetModule is string
        && request.resource.data.targetRecord is string
        && request.resource.data.timestamp is timestamp;
    }

    match /users/{userId} {
      // A signed-in user may create only their own pending account profile.
      allow create: if signedIn() && validNewUserProfile(userId);

      // Users can read their own profile. Principals and assignment creators
      // get the minimum directory access needed by their workflows.
      allow read: if canReadUserProfile(userId);

      // Only approved Principals can approve users and assign final roles.
      allow update: if validPrincipalApproval() || validPrincipalRoleChange(userId);

      // Principals may remove user profile documents from Settings,
      // but cannot delete their own active profile.
      allow delete: if isApprovedPrincipal() && request.auth.uid != userId;
    }

    match /reportAssignments/{recordId} {
      allow create: if validReportAssignmentCreate();

      allow read: if signedIn()
        && (
          resource.data.assignedToUid == request.auth.uid
          || resource.data.assignedByUid == request.auth.uid
          || isApprovedPrincipal()
        );

      allow update: if validComplianceSubmit() || validReportReviewUpdate();

      allow delete: if isApprovedPrincipal();
    }

    match /learnerMonitoring/{recordId} {
      allow create: if isLearnerMonitorRole() && validLearnerCreate();

      allow read: if canReadLearnerRecord();

      allow update: if validLearnerOwnerEdit() || validLearnerInterventionUpdate();

      allow delete: if isApprovedPrincipal();
    }

    match /classroomObservations/{recordId} {
      allow create: if validObservationCreate();

      allow read: if canReadObservationRecord();

      allow update: if validObservationCreatorEdit()
        || validObservationStatusUpdate()
        || validObservationTeacherPreNotes();

      allow delete: if isApprovedPrincipal();
    }

    match /enrollmentRecords/{recordId} {
      allow create: if validRegistrarCreate() && validEnrollmentRecordValues();
      allow read: if isEnrollmentMonitorRole() && hasAnyCurrentRole(["Principal", "Master Teacher", "Head Teacher", "Registrar"]);
      allow update: if validRegistrarUpdate() && validEnrollmentRecordValues();
      allow delete: if isApprovedPrincipal();
    }

    match /transferRecords/{recordId} {
      allow create: if validRegistrarCreate() && validTransferRecordValues();
      allow read: if isEnrollmentMonitorRole() && hasAnyCurrentRole(["Principal", "Master Teacher", "Head Teacher", "Registrar"]);
      allow update: if validRegistrarUpdate() && validTransferRecordValues();
      allow delete: if isApprovedPrincipal();
    }

    match /dropoutRecords/{recordId} {
      allow create: if validRegistrarCreate() && validDropoutRecordValues();
      allow read: if isEnrollmentMonitorRole() && hasAnyCurrentRole(["Principal", "Master Teacher", "Head Teacher", "Registrar"]);
      allow update: if validRegistrarUpdate() && validDropoutRecordValues();
      allow delete: if isApprovedPrincipal();
    }

    match /classProfiles/{recordId} {
      allow create: if validRegistrarCreate() && validClassProfileValues();
      allow read: if isEnrollmentMonitorRole();
      allow update: if validRegistrarUpdate() && validClassProfileValues();
      allow delete: if isApprovedPrincipal();
    }

    match /documents/{recordId} {
      allow create: if validDocumentCreate();
      allow read: if canReadDocument();
      allow update: if validDocumentUpdate();
      allow delete: if canManageDocument();
    }

    match /inventoryFacilities/{recordId} {
      allow create: if validInventoryFacilityCreate();
      allow read: if isInventoryFacilityViewer();
      allow update: if validInventoryFacilityUpdate();
      allow delete: if isApprovedPrincipal();
    }

    match /financialReports/{recordId} {
      allow create: if validFinancialCreate();
      allow read: if isFinancialReportViewer();
      allow update: if validFinancialManagerUpdate() || validFinancialReviewUpdate();
      allow delete: if isFinancialReportManager();
    }

    match /ppaMonitoring/{recordId} {
      allow create: if validPpaCreate();
      allow read: if canReadPpaRecord();
      allow update: if validPpaUpdate();
      allow delete: if isApprovedPrincipal();
    }

    match /classes/{recordId} {
      allow create: if isAcademicManager() && validClassCreate();
      allow read: if isAcademicViewer() || isAssignedAdviserByResource();
      allow update: if isAcademicManager() && validClassUpdate();
      allow delete: if isApprovedPrincipal();
    }

    match /schoolSubjects/{recordId} {
      allow create: if isApprovedPrincipal() && validSchoolSubjectCreate();
      allow read: if isAcademicMonitor() || isTeacherWorkloadViewer();
      allow update: if isApprovedPrincipal() && validSchoolSubjectUpdate();
      allow delete: if isApprovedPrincipal();
    }

    match /students/{recordId} {
      allow create: if (isRegistrar() || isApprovedPrincipal()) && validStudentCreate();
      allow read: if canReadAcademicRecord() || isApprovedRole("Teacher");
      allow update: if (isRegistrar() || isApprovedPrincipal()) && validStudentUpdate();
      allow delete: if isApprovedPrincipal();
    }

    match /studentAttendance/{recordId} {
      allow create: if validStudentAttendanceWrite();
      allow read: if canReadAcademicRecord();
      allow update: if (isAssignedAdviserByResource() || isAssignedClassAdviserByResource())
        && validStudentAttendanceWrite()
        && (
          request.resource.data.adviserId == resource.data.adviserId
          || request.resource.data.adviserId == request.auth.uid
        );
      allow delete: if isApprovedPrincipal();
    }

    match /teacherAttendance/{recordId} {
      allow create: if isTeacherAttendanceManager() && validTeacherAttendanceWrite();
      allow read: if isTeacherAttendanceViewer()
        || (signedIn() && resource.data.teacherId == request.auth.uid)
        || (
          signedIn()
          && userDoc(request.auth.uid).data.status == "approved"
          && hasAnyCurrentRole(["Master Teacher", "Head Teacher"])
        );
      allow update: if isTeacherAttendanceManager() && validTeacherAttendanceWrite();
      allow delete: if isApprovedPrincipal();
    }

    match /calendarEvents/{recordId} {
      allow create: if validCalendarEventCreate();
      allow read: if signedIn()
        && (
          resource.data.ownerUid == request.auth.uid
          || isCalendarSupervisorFor(resource.data.ownerUid)
        );
      allow update: if validCalendarEventOwnerUpdate();
      allow delete: if signedIn()
        && userDoc(request.auth.uid).data.status == "approved"
        && resource.data.ownerUid == request.auth.uid;
    }

    match /teacherWorkloads/{recordId} {
      allow create: if validTeacherWorkloadWrite();
      allow read: if canReadTeacherWorkloadRecord();
      allow update: if validTeacherWorkloadWrite();
      allow delete: if isApprovedPrincipal();
    }

    match /ancillaryAssignments/{recordId} {
      allow create: if validAncillaryAssignmentWrite();
      allow read: if canReadTeacherWorkloadRecord();
      allow update: if validAncillaryAssignmentWrite();
      allow delete: if isApprovedPrincipal();
    }

    match /gradeSubmissions/{recordId} {
      allow create: if validGradeSubmissionWrite();
      allow read: if canReadGradeSubmissionRecord();
      allow update: if validGradeSubmissionOwnerUpdate() || validGradeSubmissionReviewUpdate();
      allow delete: if isApprovedPrincipal();
    }

    match /dllRequests/{recordId} {
      allow create: if validDllRequestCreate();
      allow read: if isTeacherWorkloadViewer();
      allow update: if validDllRequestUpdate();
      allow delete: if isApprovedPrincipal();
    }

    match /lessonPlans/{recordId} {
      allow create: if validLessonPlanCreate(recordId);
      allow read: if isTeacherWorkloadViewer()
        && (
          hasAnyCurrentRole(["Principal", "Master Teacher", "Head Teacher"])
          || resource.data.teacherId == request.auth.uid
        );
      allow update: if validLessonPlanOwnerUpdate()
        || validLessonPlanReviewUpdate()
        || validLegacyLessonPlanReviewUpdate();
      allow delete: if isApprovedPrincipal();
    }

    match /systemSettings/{recordId} {
      allow read: if signedIn()
        && userDoc(request.auth.uid).data.status == "approved";
      allow create, update: if isApprovedPrincipal() && validTaskVisibilitySettings();
      allow delete: if isApprovedPrincipal();
    }

    match /assessments/{recordId} {
      allow create: if canWriteAssessmentRecord() && validAssessmentWrite();
      allow read: if canReadAssessmentRecord();
      allow update: if canWriteAssessmentRecord()
        && validAssessmentWrite()
        && (
          ("teacherUid" in resource.data && request.resource.data.teacherUid == resource.data.teacherUid)
          || (
            !("teacherUid" in resource.data)
            && ("encodedBy" in resource.data && resource.data.encodedBy == request.auth.uid)
          )
        );
      allow delete: if isApprovedPrincipal();
    }

    match /auditLogs/{recordId} {
      allow create: if validAuditLogCreate();
      allow read: if isApprovedPrincipal();
      allow update: if false;
      allow delete: if isApprovedPrincipal();
    }

    match /notifications/{recordId} {
      allow create: if validNotificationCreate();
      allow read: if canReadNotification() || isApprovedPrincipal();
      allow update: if validNotificationReadUpdate();
      allow delete: if isApprovedPrincipal();
    }

    // Deny all other collections until later modules define their own rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
