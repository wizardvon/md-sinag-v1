    function validGradeSubmissionWrite() {
      return isGradeSubmissionViewer()
        && hasAnyCurrentRole(["Teacher", "Master Teacher", "Head Teacher"])
        && request.resource.data.keys().hasOnly([
          "workloadId",
          "teacherId",
          "teacherUid",
          "teacherName",
          "schoolYear",
          "term",
          "quarter",
          "gradeLevel",
          "sectionId",
          "sectionName",
          "subjectId",
          "subjectName",
          "subjectArea",
          "subjectCategory",
          "submissionStatus",
          "dateSubmitted",
          "remarks",
          "grades",
          "createdBy",
          "createdByName",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.workloadId is string
        && request.resource.data.workloadId.size() > 0
        && get(/databases/$(database)/documents/teacherWorkloads/$(request.resource.data.workloadId)).data.teacherId == request.auth.uid
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherName is string
        && request.resource.data.teacherName.size() > 0
        && request.resource.data.subjectId is string
        && request.resource.data.subjectName is string
        && request.resource.data.subjectName.size() > 0
        && request.resource.data.subjectCategory is string
        && request.resource.data.subjectArea is string
        && request.resource.data.sectionId is string
        && request.resource.data.sectionId.size() > 0
        && request.resource.data.sectionName is string
        && request.resource.data.sectionName.size() > 0
        && request.resource.data.gradeLevel is string
        && request.resource.data.gradeLevel.size() > 0
        && request.resource.data.schoolYear is string
        && request.resource.data.schoolYear.size() > 0
        && validAssessmentTerm(request.resource.data.term)
        && request.resource.data.quarter == request.resource.data.term
        && request.resource.data.submissionStatus in ["Draft", "Submitted"]
        && request.resource.data.dateSubmitted is string
        && (
          request.resource.data.submissionStatus != "Submitted"
          || request.resource.data.dateSubmitted.size() > 0
        )
        && request.resource.data.remarks is string
        && request.resource.data.grades is map
        && (
          request.resource.data.submissionStatus != "Submitted"
          || request.resource.data.grades.keys().size() > 0
        )
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByName is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validGradeSubmissionOwnerUpdate() {
      return validGradeSubmissionWrite()
        && resource.data.teacherId == request.auth.uid
        && (!("teacherUid" in resource.data) || resource.data.teacherUid == request.auth.uid)
        && (!("submissionStatus" in resource.data) || resource.data.submissionStatus != "Approved")
        && request.resource.data.submissionStatus in ["Draft", "Submitted"]
        && (!("createdAt" in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        && (!("createdBy" in resource.data) || request.resource.data.createdBy == resource.data.createdBy)
        && (!("createdByName" in resource.data) || request.resource.data.createdByName == resource.data.createdByName)
        && request.resource.data.workloadId == resource.data.workloadId
        && request.resource.data.teacherId == resource.data.teacherId
        && (!("teacherUid" in resource.data) || request.resource.data.teacherUid == resource.data.teacherUid)
        && (!("term" in resource.data) || request.resource.data.term == resource.data.term)
        && (!("quarter" in resource.data) || request.resource.data.quarter == resource.data.quarter)
        && request.resource.data.sectionId == resource.data.sectionId
        && (!("subjectId" in resource.data) || request.resource.data.subjectId == resource.data.subjectId);
    }

    function validGradeSubmissionReviewUpdate() {
      return isGradeSubmissionViewer()
        && hasAnyCurrentRole(["Principal", "Master Teacher", "Head Teacher"])
        && resource.data.submissionStatus == "Submitted"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "submissionStatus",
          "remarks",
          "updatedAt"
        ])
        && request.resource.data.submissionStatus in ["Returned", "Approved"]
        && request.resource.data.remarks is string
        && request.resource.data.updatedAt is timestamp;
    }

    function isDllRequestManager() {
      return signedIn()
        && userDoc(request.auth.uid).data.status == "approved"
        && hasAnyCurrentRole(["Principal", "Master Teacher", "Head Teacher"]);
    }

    function validDllRequestValues() {
      return request.resource.data.keys().hasOnly([
          "title",
          "schoolYear",
          "term",
          "weekLabel",
          "weekStart",
          "weekEnd",
          "dueDate",
          "instructions",
          "status",
          "createdByUid",
          "createdByName",
          "createdByRole",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.schoolYear is string
        && request.resource.data.schoolYear.size() > 0
        && validAssessmentTerm(request.resource.data.term)
        && request.resource.data.weekLabel is string
        && request.resource.data.weekLabel.size() > 0
        && request.resource.data.weekStart is string
        && request.resource.data.weekStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.weekEnd is string
        && request.resource.data.weekEnd.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.weekEnd >= request.resource.data.weekStart
        && request.resource.data.dueDate is string
        && request.resource.data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.dueDate >= request.resource.data.weekStart
        && request.resource.data.instructions is string
        && request.resource.data.instructions.size() > 0
        && request.resource.data.status in ["Active", "Closed"]
        && request.resource.data.createdByUid is string
        && request.resource.data.createdByUid.size() > 0
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() > 0
        && validRole(request.resource.data.createdByRole)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validDllRequestCreate() {
      return isDllRequestManager()
        && validDllRequestValues()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByRole in currentRoles();
    }

    function validDllRequestUpdate() {
      return isDllRequestManager()
        && validDllRequestValues()
        && (
          hasCurrentRole("Principal")
          || resource.data.createdByUid == request.auth.uid
        )
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdByName == resource.data.createdByName
        && request.resource.data.createdByRole == resource.data.createdByRole
        && request.resource.data.createdAt == resource.data.createdAt;
