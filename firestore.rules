    function validNotificationCreate() {
      return signedIn()
        && validNotificationFields()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.recipientUid is string
        && request.resource.data.recipientUid.size() > 0
        && request.resource.data.recipientName is string
        && request.resource.data.recipientName.size() > 0
        && validRole(request.resource.data.recipientRole)
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() > 0
        && request.resource.data.senderRole is string
        && request.resource.data.senderRole.size() > 0
        && validNotificationType(request.resource.data.notificationType)
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.message is string
        && request.resource.data.relatedModule is string
        && request.resource.data.relatedRecordId is string
        && request.resource.data.actionUrl is string
        && request.resource.data.isRead == false
        && request.resource.data.createdAt is timestamp;
    }

    function canReadNotification() {
      return signedIn()
        && (
          resource.data.recipientUid == request.auth.uid
          || (
            userDoc(request.auth.uid).data.status == "approved"
            && resource.data.recipientRole in currentRoles()
            && resource.data.recipientUid == "role:" + resource.data.recipientRole
          )
        );
    }

    function validNotificationReadUpdate() {
      return canReadNotification()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["isRead"])
        && request.resource.data.isRead == true;
    }

    function isAcademicManager() {
      return signedIn()
        && userDoc(request.auth.uid).data.status == "approved"
        && hasAnyCurrentRole(["Principal", "Registrar"]);
    }

    function isRegistrar() {
      return isApprovedRole("Registrar");
    }

    function isAcademicViewer() {
      return signedIn()
        && userDoc(request.auth.uid).data.status == "approved"
        && hasAnyCurrentRole(["Principal", "Admin", "SuperAdmin", "Master Teacher", "Head Teacher", "Registrar"]);
    }

    function isTeacherAttendanceViewer() {
      return signedIn()
        && userDoc(request.auth.uid).data.status == "approved"
        && hasAnyCurrentRole(["Principal", "Registrar", "Administrative Officer", "Administrative Assistant"]);
    }

    function isTeacherAttendanceManager() {
      return signedIn()
        && userDoc(request.auth.uid).data.status == "approved"
        && hasAnyCurrentRole(["Principal", "Administrative Officer", "Administrative Assistant"]);
    }

    function isTeacherWorkloadViewer() {
      return signedIn()
        && userDoc(request.auth.uid).data.status == "approved"
        && hasAnyCurrentRole(["Principal", "Admin", "SuperAdmin", "Master Teacher", "Head Teacher", "Teacher"]);
    }

    function canReadTeacherWorkloadRecord() {
      return isTeacherWorkloadViewer()
        && (
          hasAnyCurrentRole(["Principal", "Admin", "SuperAdmin", "Master Teacher", "Head Teacher"])
          || ("teacherUid" in resource.data && resource.data.teacherUid == request.auth.uid)
          || ("teacherId" in resource.data && resource.data.teacherId == request.auth.uid)
          || (
            resource.data.sectionId is string
            && get(/databases/$(database)/documents/classes/$(resource.data.sectionId)).data.adviserId == request.auth.uid
          )
        );
    }

    function isGradeSubmissionViewer() {
      return signedIn()
        && userDoc(request.auth.uid).data.status == "approved"
        && hasAnyCurrentRole(["Principal", "Admin", "SuperAdmin", "Master Teacher", "Head Teacher", "Teacher"]);
    }

    function canReadGradeSubmissionRecord() {
      return isGradeSubmissionViewer()
        && (
          hasAnyCurrentRole(["Principal", "Admin", "SuperAdmin", "Master Teacher", "Head Teacher"])
          || ("teacherUid" in resource.data && resource.data.teacherUid == request.auth.uid)
          || ("teacherId" in resource.data && resource.data.teacherId == request.auth.uid)
          || (
            resource.data.sectionId is string
            && get(/databases/$(database)/documents/classes/$(resource.data.sectionId)).data.adviserId == request.auth.uid
          )
        );
    }

    function isAcademicMonitor() {
      return signedIn()
        && userDoc(request.auth.uid).data.status == "approved"
        && hasAnyCurrentRole(["Principal", "Master Teacher", "Head Teacher", "Registrar", "Teacher"]);
    }

    function isAssignedAdviserByResource() {
      return signedIn()
        && userDoc(request.auth.uid).data.status == "approved"
        && resource.data.adviserId == request.auth.uid;
    }

    function isAssignedClassAdviserByResource() {
      return signedIn()
        && userDoc(request.auth.uid).data.status == "approved"
        && resource.data.sectionId is string
        && get(/databases/$(database)/documents/classes/$(resource.data.sectionId)).data.adviserId == request.auth.uid;
    }

    function canReadAcademicRecord() {
      return isAcademicViewer() || isAssignedAdviserByResource() || isAssignedClassAdviserByResource();
    }

    function validClassStatus(status) {
      return status in ["active", "archived"];
    }

    function validStudentStatus(status) {
      return status in [
        "active",
        "transferred",
        "dropped",
        "archived",
        "Enrolled",
        "Dropout",
        "Transferred Out",
        "Transferred In",
        "Completed",
        "Archived"
      ];
    }

    function validStudentAttendanceStatus(status) {
      return status in ["Present", "Absent", "Late", "Excused"];
    }

    function validTeacherAttendanceStatus(status) {
      return status in ["Present", "Absent", "Late", "On Leave"];
    }

    function validCalendarCategory(category) {
      return category in [
        "Class Schedule",
        "Meeting",
        "School Activity",
        "Deadline",
        "Observation",
        "Intervention",
        "Personal Task",
        "Other"
      ];
    }

    function validCalendarVisibility(visibility) {
      return visibility in ["Visible to Supervisors", "Private"];
    }

    function validCalendarStatus(status) {
      return status in ["Scheduled", "Completed", "Cancelled"];
    }

    function isCalendarSupervisorFor(ownerUid) {
      return isApprovedPrincipal()
        || (
          signedIn()
          && userDoc(request.auth.uid).data.status == "approved"
          && hasAnyCurrentRole(["Master Teacher", "Head Teacher"])
          && ("Teacher" in rolesForUser(ownerUid))
        );
    }

    function validAssessmentTerm(term) {
      return term in ["Term 1", "Term 2", "Term 3"];
    }

    function validClassBase() {
      return request.resource.data.schoolYear is string
        && request.resource.data.gradeLevel is string
        && request.resource.data.sectionName is string
        && request.resource.data.adviserId is string
        && request.resource.data.adviserName is string
        && request.resource.data.totalStudents is number
        && validClassStatus(request.resource.data.status)
        && request.resource.data.createdByUid is string
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() > 0
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validClassCreate() {
      return validClassBase()
        && request.resource.data.createdByUid == request.auth.uid;
    }

    function validClassUpdate() {
      return validClassBase()
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdByName == resource.data.createdByName
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validSchoolSubjectBase() {
      return request.resource.data.subjectName is string
        && request.resource.data.subjectName.size() > 0
        && request.resource.data.subjectArea is string
        && request.resource.data.gradeLevel is string
        && request.resource.data.gradeLevel.size() > 0
        && request.resource.data.sectionId is string
        && request.resource.data.sectionName is string
        && request.resource.data.weeklyHours is number
        && validClassStatus(request.resource.data.status)
        && request.resource.data.createdByUid is string
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() > 0
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validSchoolSubjectCreate() {
